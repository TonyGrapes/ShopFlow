# ShopFlow — пример конфигурации.
# Скопируйте в .env и заполните. НЕ КОММИТИТЬ .env.
#
#   cp .env.example .env
#
# Генерация секретов:
#   openssl rand -hex 32

# ---------- Environment ----------
ENVIRONMENT=dev

# ---------- Database ----------
POSTGRES_USER=shopflow_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=shopflow
POSTGRES_HOST=db
POSTGRES_PORT=5432
SQL_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-in-production

# ---------- MinIO ----------
# MINIO_ENDPOINT — внутренний (backend → minio)
MINIO_ENDPOINT=minio:9000
# MINIO_PUBLIC_ENDPOINT — внешний (браузер → изображения)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# MinIO server credentials (root user). Обязательны для контейнера minio
# в docker-compose.yml (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
MINIO_ROOT_USER=shopflow_admin
MINIO_ROOT_PASSWORD=change-me-in-production

# S3 client credentials для backend. Должны совпадать с ROOT_USER/PASSWORD
# (тот же MinIO-root), но backend использует имена MINIO_ACCESS_KEY/SECRET_KEY.
MINIO_ACCESS_KEY=shopflow_admin
MINIO_SECRET_KEY=change-me-in-production

MINIO_BUCKET=shopflow-media
MINIO_USE_SSL=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Auth ----------
# ≥ 32 байт (256 бит) — обязательно для HS256
SECRET_KEY=change-me-to-64-hex-chars-from-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Argon2id — OWASP defaults
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=19456
ARGON2_PARALLELISM=1
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# ---------- Cookies ----------
# В prod REFRESH_COOKIE_SECURE=True обязателен
REFRESH_COOKIE_NAME=shopflow_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# ---------- Guest cart ----------
GUEST_CART_COOKIE_NAME=shopflow_cart_session
GUEST_CART_COOKIE_PATH=/api/v1
GUEST_CART_COOKIE_MAX_AGE_DAYS=30
GUEST_CART_REDIS_TTL_SECONDS=2592000
GUEST_CART_MAX_ITEMS=100

# ---------- CORS ----------
# JSON-список. В prod без localhost — валидатор отклонит.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Cache ----------
PRODUCT_LIST_CACHE_TTL_SECONDS=60
PRODUCT_LIST_CACHE_TTL_JITTER_SECONDS=10

# ---------- Frontend (Vite) ----------
# Для dev-server: http://localhost:8000.
# Для prod-сборки (docker-compose.prod.yml): пусто (relative paths).
VITE_API_URL=http://localhost:8000